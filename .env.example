# 火山方舟 AI 配置
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your-ark-api-key

# 主生成模型（教学设计/页面编排/视觉质检）
ARK_ARTIFACT_ENDPOINT=doubao-seed-2-1-pro-260628

# 轻量任务模型（AI助手/单页改写/JSON修复）
ARK_FLASH_ENDPOINT=deepseek-v4-flash-260425

# 图像生成模型（整套配图/组图生成）
ARK_IMAGE_ENDPOINT=doubao-seedream-5-0-260128

# 图像交互编辑模型（编辑器圈选局部重绘）
ARK_IMAGE_EDIT_ENDPOINT=doubao-seedream-5-0-pro-260628

# Mock 模式：true 时不调用大模型，本地模拟数据调试全链路
ARK_MOCK=false

# 服务端口
WEB_PORT=5173
SERVER_PORT=3001

# 存储路径
UPLOAD_DIR=uploads
GENERATED_DIR=generated
