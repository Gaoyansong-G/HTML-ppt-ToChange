# 火山方舟 AI 配置
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your-ark-api-key

# 课件生成使用的模型 endpoint ID（优先使用此变量）
# 示例：豆包 seed 2.0 pro
ARK_ARTIFACT_ENDPOINT=doubao-seed-2-0-pro-260215

# 兼容旧配置（未设置 ARK_ARTIFACT_ENDPOINT 时使用）
# ARK_DEEPSEEK_V4_PRO_ENDPOINT=deepseek-v4-pro-xxx
# ARK_DEEPSEEK_V4_FLASH_ENDPOINT=deepseek-v4-flash-xxx
# ARK_DOUBAO_2_0_PRO_ENDPOINT=doubao-2-0-pro-xxx

# 服务端口
WEB_PORT=5173
SERVER_PORT=3001

# 存储路径
UPLOAD_DIR=uploads
GENERATED_DIR=generated
